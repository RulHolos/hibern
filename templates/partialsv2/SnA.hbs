<div class="SnA">
    <div class="table-display">
        <h2 class="name">Spell Cards
        {{#EditMode actor}}
            <a class="item-create" data-itemname="Spell Card" data-type="Spell Card"><i class="fas fa-plus"></i></a>
            <small data-tooltip="Reset All Fatigue">(<a class="reset-all-fatigue"><i class="fas fa-recycle"></i></a>)</small>
        {{/EditMode}}</h2>
        <table class="baseatktable">
            <tr style="text-align: center; background-color: white;">
                <th>
                    <a class="roll-baseatk" data-type="Physic" data-ctx="Atk" style="text-decoration: underline;">
                        {{localize "hibern.chars.atkPhysic"}}</a>
                    <a class="roll-baseatk" data-type="Physic" data-ctx="Dmg" data-tooltip="Lancer Dégâts Uniquement">
                        (<i class="fas fa-crosshairs"></i>)</a>
                </th>
                <th>
                    <a class="roll-baseatk" data-type="Magic" data-ctx="Atk" style="text-decoration: underline;">
                        {{localize "hibern.chars.atkMagic"}}</a>
                    <a class="roll-baseatk" data-type="Magic" data-ctx="Dmg" data-tooltip="Lancer Dégâts Uniquement">
                        (<i class="fas fa-crosshairs"></i>)</a>
                </th>
            </tr>
        </table>
        <div class="scroll-container table-border">
            <table class="item-list">
                {{#if (eq spellcards.length 0)}}
                <tr>
                    <td style="text-align: center;">{{localize "hibern.chars.NoSpells"}}</td>
                </tr>
                {{else}}
                    {{#each spellcards as |spell id|}}
                    <tr class="item spell-table-content" data-itemid="{{spell._id}}" data-item-id="{{spell._id}}">
                        <td class="item-name spell-name"><a class="use-spellcard fullsizelinkwidth text-flow1
                            {{#if (eq spell.system.AS true)}}ASName{{/if}}" data-itemid="{{spell._id}}">({{spell.system.Fatigue}}) {{spell.name}}</a></td>
                        <td class="item-description">
                            <span class="text-flow1">{{breaklines spell.system.Description}}</span>
                        </td>
                        {{#EditMode ../actor}}
                        <td class="item-controls">
                            <a class="item-control item-delete" data-itemid="{{spell._id}}"><i class="fas fa-trash"></i></a>
                            <a class="item-control item-edit" data-itemid="{{spell._id}}"><i class="fas fa-edit"></i></a>
                        </td>
                        {{/EditMode}}
                    </tr>
                    {{/each}}
                {{/if}}
            </table>
        </div>
    </div>

    <div class="table-display">
        <h2 class="name" style="margin-bottom: 0px;">{{localize "hibern.chars.abilities"}}
            {{#EditMode actor}}
                <a class="item-create" data-itemname="Capacité" data-type="Capacité"><i class="fas fa-plus"></i></a>
            {{/EditMode}}
        </h2>
        <div class="scroll-container table-border">
            <table class="item-list">
                {{#if (eq abilities.length 0)}}
                <tr>
                    <td style="text-align: center;">{{localize "hibern.chars.NoAbilities"}}</td>
                </tr>
                {{else}}
                    {{#each abilities as |ability id|}}
                    <tr class="item spell-table-content" data-itemid="{{ability._id}}" data-item-id="{{ability._id}}">
                        <td class="item-name spell-name">
                            {{#if (eq ability.system.PostureCustom true)}}
                                <span class="fullsizelinkwidth text-flow1 posture">
                                    {{ability.name}}
                                </span>
                            {{else}}
                                <a class="use-ability fullsizelinkwidth text-flow1 {{#if (eq ability.system.Actif true)}}actif{{else}}passif{{/if}}"
                                    data-itemid="{{ability._id}}">
                                    {{#if (eq ability.system.Actif true)}}({{ability.system.Fatigue}}){{/if}} {{ability.name}}
                                </a>
                            {{/if}}
                        </td>
                        <td class="item-description" style="width: 60% !important;">
                            <span class="text-flow1">{{breaklines ability.system.Description}}</span>
                        </td>
                        <td class="item-specialisation">
                            <span>{{ability.system.Spécialisation}}</span>
                        </td>
                        {{#EditMode ../actor}}
                        <td class="item-controls">
                            <a class="item-control item-delete" data-itemid="{{ability._id}}"><i class="fas fa-trash"></i></a>
                            <a class="item-control item-edit" data-itemid="{{ability._id}}"><i class="fas fa-edit"></i></a>
                        </td>
                        {{/EditMode}}
                    </tr>
                    {{/each}}
                {{/if}}
            </table>
        </div>
    </div>
</div>