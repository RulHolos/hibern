<section class="dice-roll second-background">
    <div class="roll">
        <div class="name {{#if (eq isAS true)}}ASName{{/if}}"><span>{{spell.name}}</span></div>
        <div class="{{Successtype}} content" style="text-align: center;">
            {{#if (eq reussiteAuto true)}}
                <span style="text-decoration: underline;" class="big-number">{{localize "hibern.rolls.ReussiteAuto"}}</span><br>
            {{else}}
                <span style="text-decoration: underline;" class="big-number" data-tooltip="{{rollResultFormula}}">{{rollResult}}</span></br>
                <span style="font-size: 14px; text-decoration: none;">({{localizeResult}})</span></br>
            {{/if}}
            {{#if (eq Degats 0)}}
            {{else}}
                <span class="big-number">{{localize "hibern.objects.Damage"}} : <i data-tooltip="{{DegatsFormula}}">{{Degats}}</i></span><br>
            {{/if}}
            <span style="color: gray; font-size: small; text-shadow: none;">
                {{#if (eq isAS true)}}
                    {{breaklines spell.system.ASDescription}}
                {{else}}
                    {{breaklines spell.system.Description}}
                {{/if}}</span><br>
            <span style="color: gray; font-size: 10px; text-shadow: none; font-style: italic;">({{localizeActionType}})</span>
        </div>
    </div>
</section>