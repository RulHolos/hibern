<form>
    <div class="form-group">
        <label><b>{{localize "hibern.rolls.Difficulty"}}</b></label>
        <select name="Diff">
            {{#select Diff}}
                <option value="{{difficulties.veryeasy}}">{{localize "hibern.rolls.veryeasy"}}</option>
                <option value="{{difficulties.easy}}">{{localize "hibern.rolls.easy"}}</option>
                <option value="{{difficulties.normal}}" selected>{{localize "hibern.rolls.normal"}}</option>
                <option value="{{difficulties.hard}}">{{localize "hibern.rolls.hard"}}</option>
                <option value="{{difficulties.veryhard}}">{{localize "hibern.rolls.veryhard"}}</option>
            {{/select}}
        </select>
    </div>
    {{#if (eq NeedFatigue true)}}
    <div class="form-group">
        <label><b>{{localize "hibern.Divers.AffectFatigue"}}</b></label>
        <input type="checkbox" name="AffectFatigue" value="AffectFatigue" data-dtype="Boolean" checked/>
    </div>
    {{/if}}
    {{#if (eq NeedReussiteAuto true)}}
    <div class="form-group">
        <label><b>{{localize "hibern.objects.ReussiteAuto"}}</b></label>
        <input type="checkbox" name="ReussiteAuto" value="ReussiteAuto" data-dtype="Boolean" {{#if (eq ReussiteAuto true)}}checked{{/if}}/>
    </div>
    {{/if}}
</form>