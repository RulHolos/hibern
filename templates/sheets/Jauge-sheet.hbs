<form class="{{cssClass}} border-around" autocomplete="off">
    <div class="row main-bg">
        <div class="col-7 outer-border">
            <div class="main-margin">
                <p class="field-name"><b>Couleur Vide</b></p>
                <input type="text" name="system.EmptyColor" value="{{item.system.EmptyColor}}" data-dtype="text"/>
                <p class="field-name"><b>Couleur Pleine</b></p>
                <input type="text" name="system.FullColor" value="{{item.system.FullColor}}" data-dtype="text"/>
                <p class="field-name"><b>Couleur de Fond</b></p>
                <input type="text" name="system.BgColor" value="{{item.system.BgColor}}" data-dtype="text"/>
                <p class="field-name"><b>Description</b></p>
<textarea name="system.Description" rows="4" placeholder="Description">{{{item.system.Description}}}</textarea>
            </div>
        </div>
        <div class="col-5 sheet-header header">
            <h1 class="item-type">{{localize "hibern.objects.object"}}
                ({{localize "hibern.objects.Cost"}}: <input class="MarchandCost-input" type="number" name="system.MarchandCost" value="{{item.system.MarchandCost}}"/>)</h1>
            <h1><input name="name" type="text" value="{{item.name}}" placeholder="Name" class="header" /></h1>
            <img src="{{item.img}}" data-edit="img" title="{{item.name}}" height="200" width="200" />
        </div>
    </div>
</form>